{
  "name": "geothai",
  "version": "4.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "data": "bun scripts/data.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "test:pack": "bun run build && bun scripts/pack-test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "eslint-plugin-jsdoc": "65.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
