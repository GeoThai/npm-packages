{
  "name": "geothai",
  "version": "4.2.1",
  "description": "Every province, district, subdistrict and postal code of Thailand, with types and search",
  "keywords": [
    "address",
    "districts",
    "postal-code",
    "provinces",
    "subdistricts",
    "thailand"
  ],
  "homepage": "https://geothai.fasu.dev",
  "license": "MIT AND CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoThai/npm-packages.git"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./abolished": "./dist/abolished.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "data": "bun scripts/data.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "size": "bun run build && size-limit",
    "test": "bun test",
    "test:pack": "bun run build && bun scripts/pack-test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@size-limit/preset-small-lib": "14.2.0",
    "@types/bun": "1.4.3",
    "eslint-plugin-jsdoc": "65.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2"
}
